DATABASE_URL=postgres://rustspeak:rustspeak@localhost:5432/rustspeak
BIND_ADDR=127.0.0.1:8443
JWT_SECRET=dev-only-change-me-in-production-at-least-32-bytes
TLS_CERT_PATH=certs/localhost.pem
TLS_KEY_PATH=certs/localhost-key.pem
INSECURE_DEV=false
STUN_URL=stun:stun.l.google.com:19302
ICE_UDP_PORT_MIN=40000
ICE_UDP_PORT_MAX=40100
# For VPS deployment with Caddy automatic Let's Encrypt TLS (no self-signed cert needed):
# PUBLIC_HOST=<YOUR_VPS_IP>.sslip.io
PUBLIC_HOST=:80
RUST_LOG=info,rs_server=debug
